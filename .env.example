# PostgreSQL connection string for the local or production database.
# Production credentials must stay only in the real .env file on the VPS.
DATABASE_URL=postgres://vedishev:CHANGE_ME@127.0.0.1:5432/vedishev

# Used to encrypt JWT tokens
PAYLOAD_SECRET=CHANGE_ME_PAYLOAD_SECRET

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=CHANGE_ME_CRON_SECRET

# Used to validate preview requests
PREVIEW_SECRET=CHANGE_ME_PREVIEW_SECRET
